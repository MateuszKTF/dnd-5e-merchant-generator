---
import GeneratorIsland from "@/components/GeneratorIsland";
import Layout from "@/layouts/Layout.astro";

// Every page is prerendered (AGENTS.md hard rule): `output: "server"` stays for
// the deploy pipeline, but nothing user-facing renders per request. Verify after
// a build that this route appears as HTML under `dist/client/`.
export const prerender = true;
---

<Layout>
  <!-- client:load, not client:visible: the generator IS the page, so the first
       interaction must not wait on an intersection observer. The island is the
       generator wrapped in an error boundary — see GeneratorIsland.tsx. -->
  <GeneratorIsland client:load />
</Layout>
